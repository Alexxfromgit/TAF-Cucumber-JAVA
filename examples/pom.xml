<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.alexxfromgit</groupId>
        <artifactId>cucumber-taf-parent</artifactId>
        <version>2.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>examples</artifactId>
    <name>cucumber-taf :: examples</name>
    <description>Example features for the Sauce Labs demo shop (web) and DummyJSON (API). Replace with your own.</description>

    <properties>
        <!-- override on the command line: -Denv=ci -Dcucumber.filter.tags="@smoke" -->
        <env>default</env>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.github.alexxfromgit</groupId>
            <artifactId>taf-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.aspectj</groupId>
            <artifactId>aspectjweaver</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <taf.env>${env}</taf.env>
                        <allure.results.directory>${project.build.directory}/allure-results</allure.results.directory>
                        <taf.reports-dir>${project.build.directory}/taf-reports</taf.reports-dir>
                        <!-- Public demo passwords published by the demo sites themselves.
                             Real credentials are provided as environment variables / CI secrets, never in files. -->
                        <users.standard.password>secret_sauce</users.standard.password>
                        <users.locked.password>secret_sauce</users.locked.password>
                        <users.api.password>emilyspass</users.api.password>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <plugin>
                <groupId>io.qameta.allure</groupId>
                <artifactId>allure-maven</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
